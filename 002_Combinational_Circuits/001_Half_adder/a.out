v0x5fd666d6f4e0_0 .net "s", 0 0, L_0x5fd666d6f5b0;  1 drivers
S_0x5fd666d5d9b0 .scope module, "uut" "half_adder" 2 5, 3 1 0, S_0x5fd666d5d820;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "s";
    .port_info 3 /OUTPUT 1 "c";
L_0x5fd666d6f5b0 .functor XOR 1, v0x5fd666d6f250_0, v0x5fd666d6f310_0, C4<0>, C4<0>;
L_0x5fd666d6f710 .functor AND 1, v0x5fd666d6f250_0, v0x5fd666d6f310_0, C4<1>, C4<1>;
v0x5fd666d24490_0 .net "a", 0 0, v0x5fd666d6f250_0;  1 drivers
v0x5fd666d6ef50_0 .net "b", 0 0, v0x5fd666d6f310_0;  1 drivers
v0x5fd666d6f010_0 .net "c", 0 0, L_0x5fd666d6f710;  alias, 1 drivers
v0x5fd666d6f0e0_0 .net "s", 0 0, L_0x5fd666d6f5b0;  alias, 1 drivers
    .scope S_0x5fd666d5d820;
T_0 ;
    %vpi_call 2 12 "$dumpfile", "half_adder.vcd" {0 0 0};
    %vpi_call 2 13 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5fd666d5d820 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5fd666d6f250_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5fd666d6f310_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5fd666d6f250_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5fd666d6f310_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5fd666d6f250_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5fd666d6f310_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5fd666d6f250_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5fd666d6f310_0, 0, 1;
    %delay 10000, 0;
