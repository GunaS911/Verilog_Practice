#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
S_0x56fafdb8c230 .scope module, "not_tb" "not_tb" 2 2;
 .timescale -9 -12;
v0x56fafdb9b8f0_0 .var "a", 0 0;
v0x56fafdb9b990_0 .net "y", 0 0, L_0x56fafdb9ba60;  1 drivers
S_0x56fafdb8c3c0 .scope module, "uut" "not_gate" 2 5, 3 1 0, S_0x56fafdb8c230;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /OUTPUT 1 "y";
L_0x56fafdb9ba60 .functor NOT 1, v0x56fafdb9b8f0_0, C4<0>, C4<0>, C4<0>;
v0x56fafdb8c5a0_0 .net "a", 0 0, v0x56fafdb9b8f0_0;  1 drivers
v0x56fafdb9b7d0_0 .net "y", 0 0, L_0x56fafdb9ba60;  alias, 1 drivers
    .scope S_0x56fafdb8c230;
T_0 ;
    %vpi_call 2 10 "$dumpfile", "not.vcd" {0 0 0};
    %vpi_call 2 11 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x56fafdb8c230 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x56fafdb9b8f0_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x56fafdb9b8f0_0, 0, 1;
    %delay 10000, 0;
    %vpi_call 2 14 "$finish" {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "not_tb.v";
    "not_gate.v";
