#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
S_0x645fdf9d54f0 .scope module, "xor_tb" "xor_tb" 2 2;
 .timescale -9 -12;
v0x645fdfa1f7d0_0 .var "a", 0 0;
v0x645fdfa1f8a0_0 .var "b", 0 0;
v0x645fdfa1f970_0 .net "y", 0 0, v0x645fdfa1f6b0_0;  1 drivers
S_0x645fdf9d5680 .scope module, "uut" "xor_gate" 2 5, 3 1 0, S_0x645fdf9d54f0;
 .timescale -9 -12;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "y";
v0x645fdfa0f9a0_0 .net "a", 0 0, v0x645fdfa1f7d0_0;  1 drivers
v0x645fdfa1f5f0_0 .net "b", 0 0, v0x645fdfa1f8a0_0;  1 drivers
v0x645fdfa1f6b0_0 .var "y", 0 0;
E_0x645fdfa10500 .event anyedge, v0x645fdfa0f9a0_0, v0x645fdfa1f5f0_0;
    .scope S_0x645fdf9d5680;
T_0 ;
    %wait E_0x645fdfa10500;
    %load/vec4 v0x645fdfa0f9a0_0;
    %load/vec4 v0x645fdfa1f5f0_0;
    %xor;
    %store/vec4 v0x645fdfa1f6b0_0, 0, 1;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_0x645fdf9d54f0;
T_1 ;
    %vpi_call 2 11 "$dumpfile", "xor.vcd" {0 0 0};
    %vpi_call 2 12 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x645fdf9d54f0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x645fdfa1f7d0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x645fdfa1f8a0_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x645fdfa1f7d0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x645fdfa1f8a0_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x645fdfa1f7d0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x645fdfa1f8a0_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x645fdfa1f7d0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x645fdfa1f8a0_0, 0, 1;
    %delay 10000, 0;
    %vpi_call 2 17 "$finish" {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "xor_tb.v";
    "Xor_behavioral.v";
