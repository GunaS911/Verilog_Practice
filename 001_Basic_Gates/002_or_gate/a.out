#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
S_0x5e04853c42e0 .scope module, "or_tb" "or_tb" 2 2;
 .timescale -9 -12;
v0x5e04853d5810_0 .var "a", 0 0;
v0x5e04853d58e0_0 .var "b", 0 0;
v0x5e04853d59b0_0 .net "y", 0 0, v0x5e04853d56f0_0;  1 drivers
S_0x5e04853c4470 .scope module, "uut" "or_gate" 2 7, 3 1 0, S_0x5e04853c42e0;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "y";
v0x5e048538b490_0 .net "a", 0 0, v0x5e04853d5810_0;  1 drivers
v0x5e04853d5630_0 .net "b", 0 0, v0x5e04853d58e0_0;  1 drivers
v0x5e04853d56f0_0 .var "y", 0 0;
E_0x5e048538bdc0 .event anyedge, v0x5e048538b490_0, v0x5e04853d5630_0;
    .scope S_0x5e04853c4470;
T_0 ;
    %wait E_0x5e048538bdc0;
    %load/vec4 v0x5e048538b490_0;
    %flag_set/vec4 8;
    %flag_get/vec4 8;
    %jmp/1 T_0.0, 8;
    %load/vec4 v0x5e04853d5630_0;
    %or;
T_0.0;
    %store/vec4 v0x5e04853d56f0_0, 0, 1;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_0x5e04853c42e0;
T_1 ;
    %vpi_call 2 14 "$dumpfile", "or.vcd" {0 0 0};
    %vpi_call 2 15 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5e04853c42e0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5e04853d5810_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5e04853d58e0_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5e04853d5810_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5e04853d58e0_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5e04853d5810_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5e04853d58e0_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5e04853d5810_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5e04853d58e0_0, 0, 1;
    %delay 10000, 0;
    %vpi_call 2 21 "$finish" {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "or_tb.v";
    "or_behavioral.v";
